{
  "manifest_version": 3,
  "name": "KAMINARI GG",
  "version": "3.0",
  "description": "AIMBOT ESP LINE X4",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "notifications",
    "alarms"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "action": {
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png"
  },
  "host_permissions": [
    "https://dragonbound.net/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://dragonbound.net/*"],
      "js": ["scripts/injector.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
